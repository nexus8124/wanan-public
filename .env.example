# ============================================================
# XH-202614-security-agent 环境变量模板
# 用法：复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会入库。
# ============================================================

# ----- LLM Provider -----
# 主力：DeepSeek（赛题点名，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
# OpenAI 兼容接口地址；官方 DeepSeek 可留空并使用代码默认值
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEND_THINKING=false

# 备选：阿里云 Qwen（可选）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# SiliconFlow OpenAI-compatible endpoint (default: Qwen/Qwen3.5-9B)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OpenAI-compatible relay endpoint
OPENAI_RELAY_API_KEY=
OPENAI_RELAY_BASE_URL=https://www.cctq.ai/v1

# 深信服安全 GPT（Week 4-7 拿到平台权限后接入，此处留空）
SANGFOR_API_KEY=
SANGFOR_BASE_URL=

# ----- LLM 调用参数 -----
# 默认 provider：deepseek | qwen | siliconflow | openai_relay | sangfor
LLM_PROVIDER=deepseek
# DeepSeek V4 模型名：deepseek-v4-flash（主力）/ deepseek-v4-pro（Pro）
# 注：deepseek-chat / deepseek-reasoner 已于 2026/07/24 弃用
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1

# ----- 应用配置 -----
APP_ENV=dev
APP_PORT=8000

# ----- 评测数据集（可选）-----
# AIT-ADS 适配器默认生成到这个位置；留空则继续使用内置 50 条样本
EVAL_DATASET_PATH=

# ----- ReAct 执行护栏（可选，以下均为默认值）-----
REACT_MAX_STEPS=3
REACT_TOOL_TIMEOUT_S=10
# 同时作为模型客户端默认请求超时；图内每次调用会传入动态剩余时间
REACT_GLOBAL_TIMEOUT_S=120
REACT_TOOL_RETRIES=1
REACT_MAX_LLM_CALLS=5
# 当前为跨 Provider 的保守估算上限；真实 Token 仍由评测回调精确记录
REACT_MAX_ESTIMATED_TOKENS=30000
REACT_MAX_NO_EVIDENCE=2

# ----- RAG 知识增强（第三阶段）-----
# 默认关闭，评测时可通过 API/CLI 显式开启，便于 No-RAG / RAG 公平对照。
RAG_ENABLED=false
RAG_CORPUS_VERSION=rag-v3-20260805
# 留空时使用 data/knowledge/rag.sqlite3
RAG_DB_PATH=
# 留空时加载 backend/app/rag/playbooks；可额外指向自己的 YAML 目录。
RAG_PLAYBOOK_PATH=
# 可选：SigmaHQ 规则目录与 MITRE ATT&CK enterprise-attack.json。
RAG_SIGMA_PATH=data/raw/knowledge/sigma/extracted
RAG_ATTACK_STIX_PATH=data/raw/knowledge/mitre/enterprise-attack.json
# hashing 无需下载模型；另行安装 sentence-transformers 后可改为 sentence_transformer。
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_TOP_K=10
RAG_CANDIDATE_K=60
RAG_MIN_SCORE=0.20
# 只对待查或低于该置信度的已决样本启动 RAG 晚融合。
RAG_TRIGGER_CONFIDENCE=0.65
# DNS/TLS/通用 IDS/新颖性等弱信号的高置信真阳执行一次知识校准。
# 高置信假阳不强制校准；知识不能代替事件证据将其升级为真阳。
RAG_CALIBRATE_WEAK_SIGNALS=true
RAG_MAX_CONTEXT_CHARS=9000
# 仅在明确出现 CVE 编号时访问 NVD，并将结果缓存；正式可复现实验建议保持 false。
RAG_NVD_ONLINE=false
RAG_NVD_TIMEOUT_S=15
